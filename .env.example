# Configuración de Base de Datos PostgreSQL
# Formato: postgresql+psycopg2://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/splitpay_db

# Configuración de Seguridad y Autenticación JWT
SECRET_KEY=cambiar_esta_clave_secreta_por_una_segura_en_produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Configuración de CORS (orígenes permitidos separados por comas)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
